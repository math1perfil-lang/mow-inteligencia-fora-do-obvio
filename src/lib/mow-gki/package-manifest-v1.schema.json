{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MOW GKI Package Manifest v1",
  "description": "Contrato fechado do manifesto do pacote GKI v1. A ordenação crescente dos arrays source_ids e artifact_ids é validada em runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "research_run_id",
    "protocol_version",
    "review_policy_version",
    "final_package_artifact_id",
    "source_ids",
    "artifact_ids",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "mow-gki-package/v1"
    },
    "research_run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "review_policy_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "final_package_artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "description": "UUIDs em ordem crescente lexical; a ordenação é reforçada em runtime."
    },
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "description": "UUIDs em ordem crescente lexical; a ordenação é reforçada em runtime."
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
